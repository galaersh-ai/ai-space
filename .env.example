# AI Space Configuration
# Copy to .env and fill in your values

# === LLM API ===
API_URL=https://api.us-west-2.modal.direct/v1/chat/completions
API_KEY=your-api-key-here
MODEL=zai-org/GLM-5-FP8

# === Telegram ===
TG_BOT_TOKEN=123456:ABC-your-bot-token
TG_CHAT_ID=your-chat-id
TG_SYSTEM_BOT_TOKEN=123456:ABC-system-bot-token

# === Limits (optional) ===
# MAX_STEPS=20
# SESSION_TIMEOUT=1500
# COMMAND_TIMEOUT=60
# CIRCUIT_BREAKER_THRESHOLD=3

# === Dashboard (optional) ===
# DASHBOARD_PORT=8080
